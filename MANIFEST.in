include README.md README.zh-CN.md CONTRIBUTING.md SECURITY.md CHANGELOG.md LICENSE
include docs/design.md
include docs/design/first-usable-version.md
recursive-include docs/handbook *.md *.json
recursive-include examples/handbook *.py
include docs/assets/demo.gif
include build_backend.py
include examples/demo/run.py
include examples/vitest/run.py
include tests/*.py
recursive-include tests/fixtures *.log *.json
recursive-include src/dv *.py *.mjs LICENSE NOTICE
include .github/workflows/*.yml
prune artifacts
prune .dv
global-exclude __pycache__ *.py[cod] .DS_Store
